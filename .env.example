# OpenAI API Key (required)
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI base URL for relay services (e.g., 灵眸)
# If not set, uses official OpenAI API endpoint
OPENAI_BASE_URL=https://your-relay-service.com/v1

# Alternative: Use Browser Use Cloud API
# BROWSER_USE_API_KEY=your_browser_use_api_key_here

# Alternative: Use other providers directly
# ANTHROPIC_API_KEY=your_anthropic_key_here
# GOOGLE_API_KEY=your_google_key_here
