# Anthropic API Key (via relay service like 灵眸)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom Anthropic base URL for relay services (e.g., 灵眸)
# If not set, uses official Anthropic API endpoint
ANTHROPIC_BASE_URL=https://your-relay-service.com

# Alternative: Use Browser Use Cloud API
# BROWSER_USE_API_KEY=your_browser_use_api_key_here
